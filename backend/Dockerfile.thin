FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libsqlite3-0 \
    ca-certificates \
    postgresql-client \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从上下文目录拷贝预编译好的二进制
COPY tokensbyte-server /app/tokensbyte-server

RUN chmod +x /app/tokensbyte-server && mkdir -p /app/data

EXPOSE 3000
STOPSIGNAL SIGTERM
CMD ["/app/tokensbyte-server"]
